MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=gold-bars
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=change-me
MONGODB_URI=mongodb://app_user:change-me@localhost/gold-bars
# Server-only. Set this at container runtime. Do not prefix with NEXT_PUBLIC_.
API_KEY=change-me
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology/
# Leave empty so the browser calls the same origin (the PoC on port 3000).
NEXT_PUBLIC_API_URL=
